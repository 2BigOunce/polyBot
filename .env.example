# Alchemy — Polygon RPC key
ALCHEMY_API_KEY=your_alchemy_api_key_here

# --- RPC Provider ---
RPC_WS_URL=wss://...      
RPC_HTTP_URL=https://...  

# Polygon wallet (never commit real values)
WALLET_PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# Polygonscan (wallet age lookup — free tier: 5 req/s)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Polymarket CLOB API
CLOB_API_KEY=your_clob_api_key_here
CLOB_SECRET=your_clob_secret_here
CLOB_PASSPHRASE=your_clob_passphrase_here
